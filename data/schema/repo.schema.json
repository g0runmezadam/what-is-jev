{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tunahansahin897/what-is-jev/data/schema/repo.schema.json",
  "title": "Scored repository row (data/repos.jsonl)",
  "description": "One line of data/repos.jsonl. Every row carries a source link: url and evidence_url are both required and must be http(s).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo", "url", "source_set", "first_seen", "scored_at", "rubric_version",
    "meta", "category", "calls_jev", "question_types", "scores", "total",
    "class", "summary_en", "summary_tr", "takeaway_en", "takeaway_tr",
    "risk_en", "risk_tr", "evidence_url", "audited", "audit_note_en",
    "audit_note_tr", "duplicate_of", "status", "score_batch"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$",
      "description": "owner/name, unique case-insensitively"
    },
    "url": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$",
      "description": "Repository URL. Required. A row without it is not written."
    },
    "source_set": {"enum": ["discord", "topic", "manual"]},
    "first_seen": {
      "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date",
      "description": "A real calendar day, not only four-two-two digits."
    },
    "scored_at": {
      "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date",
      "description": "A real calendar day. An older one never overwrites a newer one."
    },
    "rubric_version": {
      "type": "integer", "enum": [1],
      "description": "A known version of data/rubric.md; anything else is refused."
    },
    "score_batch": {
      "type": "string",
      "pattern": "^(initial|[0-9a-f]{12})$",
      "description": "Which incoming file this score came from: the first twelve hex digits of that file's sha256, as data/applied-batches.jsonl records it. The first data set says \"initial\". A scorer never writes it; the merge stamps it on. An audit must quote the value the row carried, or it is not applied."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "stars", "forks", "language", "license",
                   "created_at", "pushed_at", "archived", "fork", "topics"],
      "properties": {
        "description": {"type": ["string", "null"]},
        "stars": {"type": ["integer", "null"]},
        "forks": {"type": ["integer", "null"]},
        "language": {"type": ["string", "null"]},
        "license": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "null"]},
        "pushed_at": {"type": ["string", "null"]},
        "archived": {"type": ["boolean", "null"]},
        "fork": {"type": ["boolean", "null"]},
        "topics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "category": {
      "enum": ["agent-gate", "code-review-hook", "model-router",
               "compaction-memory", "classification-triage", "search-rerank",
               "security-injection", "browser-computer-use", "game-demo",
               "sdk-client", "cli", "mcp-skill-plugin", "eval-benchmark",
               "list-directory", "text-generation-experiment", "other"]
    },
    "calls_jev": {"enum": ["yes", "no", "unclear"]},
    "question_types": {
      "type": "array",
      "items": {"enum": ["choice", "score", "noul"]},
      "uniqueItems": true
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depth", "relevance", "novelty", "maturity", "evidence"],
      "properties": {
        "depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "relevance": {"type": "integer", "minimum": 0, "maximum": 3},
        "novelty": {"type": "integer", "minimum": 0, "maximum": 3},
        "maturity": {"type": "integer", "minimum": 0, "maximum": 3},
        "evidence": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "total": {"type": "integer", "minimum": 0, "maximum": 15},
    "class": {"enum": ["A", "B", "C"]},
    "summary_en": {"type": "string"},
    "summary_tr": {"type": "string"},
    "takeaway_en": {"type": "string"},
    "takeaway_tr": {"type": "string"},
    "risk_en": {"type": "string"},
    "risk_tr": {"type": "string"},
    "evidence_url": {
      "type": "string",
      "pattern": "^https?://",
      "description": "The public page the score rests on. Falls back to url."
    },
    "audited": {"type": "boolean"},
    "audit_note_en": {
      "type": "string",
      "description": "The public audit note in English. Never the auditor's own internal note."
    },
    "audit_note_tr": {"type": "string", "description": "The public audit note in Turkish."},
    "audited_at": {
      "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "format": "date",
      "description": "Optional. The day an auditor read this row. A row nobody has audited does not carry the field at all; an audit older than scored_at is never applied."
    },
    "duplicate_of": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
    },
    "status": {"enum": ["active", "gone"]}
  }
}
